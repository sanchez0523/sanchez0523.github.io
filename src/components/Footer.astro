---
import { SITE } from '~/consts';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap footer-inner">
    <div class="left">
      <span class="mark">sanchez<span class="paren">()</span></span>
      <span class="sep">·</span>
      <span>{SITE.tagline}</span>
    </div>
    <div class="right">
      <a href="/rss.xml" aria-label="RSS feed">rss</a>
      <a href={SITE.github} target="_blank" rel="noopener">github</a>
      <a href={`mailto:${SITE.email}`}>email</a>
      <span class="sep">·</span>
      <span>© {year}</span>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border);
    padding: 28px 0 56px;
    margin-top: 64px;
  }
  .footer-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
    font-family: var(--mono);
    font-size: 11px;
    color: var(--muted);
    letter-spacing: 0.02em;
  }
  .left, .right {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .mark { color: var(--text); font-weight: 600; }
  .mark .paren { color: var(--muted); font-weight: 500; }
  .sep { color: var(--dim); }
  a { transition: color 120ms var(--ease); }
  a:hover { color: var(--accent); }
  @media (max-width: 540px) {
    .footer-inner { flex-direction: column; align-items: flex-start; }
  }
</style>